# ===== Database (PostgreSQL) =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kilatmart"

# ===== Sesi (WAJIB diganti di produksi, min. 32 karakter acak) =====
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# ===== OTP =====
# mock     : kode OTP dicetak di log server & ditampilkan di UI (khusus dev)
# whatsapp : kirim OTP via WhatsApp menggunakan Evolution API
OTP_MODE="whatsapp"

# ===== Evolution API (WhatsApp OTP) =====
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE="default"

# ===== Pembayaran =====
# mock     : tombol "Simulasi bayar" tersedia (khusus dev/staging)
# midtrans : webhook produksi aktif, verifikasi signature SHA-512
PAYMENT_MODE="mock"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# ===== Opsional =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
