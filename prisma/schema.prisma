// KilatMart — skema database sesuai PRD §10.3 (ERD)
// Catatan implementasi:
// - Semua nominal uang disimpan sebagai Int (Rupiah tanpa sen).
// - service_zones.polygon disimpan sebagai Json [[lat,lng],...]; pengecekan
//   point-in-polygon dilakukan di aplikasi (src/lib/geo.ts). Untuk skala besar,
//   migrasikan ke PostGIS geometry sesuai rekomendasi PRD.
// - Enum memakai String agar selaras dengan ERD (varchar) dan mudah dievolusi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  phone_number             String    @unique
  name                     String    @default("")
  email                    String?
  date_of_birth            DateTime?
  is_age_verified          Boolean   @default(false)
  preferred_drop_point_id  String?
  referral_code            String    @unique
  referred_by_user_id      String?
  status                   String    @default("active") // active | blocked
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  deleted_at               DateTime? // soft delete (UU PDP)

  preferredDropPoint DropPoint? @relation("UserPreferredDropPoint", fields: [preferred_drop_point_id], references: [id], onDelete: SetNull)
  addresses          Address[]
  carts              Cart[]
  orders             Order[]
  direct_orders      DirectOrder[]
  reviews            Review[]
  product_reviews    ProductReview[]
  freshness_claims   FreshnessClaim[]
  voucher_usages     VoucherUsage[]
  voucher_claims     ClaimedVoucher[]
  notifications      Notification[]
  announcement_reads UserAnnouncementRead[]
  chat_threads       ChatThread[]
  referrals_made     Referral[]       @relation("Referrer")
  referral_record    Referral?        @relation("Referee")

  @@map("users")
}

model Address {
  id              String   @id @default(uuid())
  user_id         String
  label           String   @default("rumah") // rumah | kantor | lainnya
  recipient_name  String
  recipient_phone String
  full_address    String
  latitude        Float
  longitude       Float
  courier_note    String?
  is_default      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user   User    @relation(fields: [user_id], references: [id])
  orders Order[]

  @@map("addresses")
}

model WaitingList {
  id           String   @id @default(uuid())
  phone        String
  email        String?
  address_text String
  latitude     Float
  longitude    Float
  created_at   DateTime @default(now())

  @@map("waiting_lists")
}

model Hub {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  address         String
  latitude        Float
  longitude       Float
  operating_hours Json     @default("{\"open\":\"00:00\",\"close\":\"24:00\"}")
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  service_zones  ServiceZone[]
  hub_stocks     HubStock[]
  orders         Order[]
  partners       Partner[]
  picking_tasks  PickingTask[]
  carts          Cart[]

  @@map("hubs")
}

model ServiceZone {
  id                      String  @id @default(uuid())
  hub_id                  String
  name                    String
  polygon                 Json // [[lat,lng], ...]
  delivery_fee_base       Int
  free_delivery_threshold Int
  min_order_amount        Int
  is_active               Boolean @default(true)

  hub Hub @relation(fields: [hub_id], references: [id])

  @@map("service_zones")
}

model Partner {
  id            String   @id @default(uuid())
  hub_id        String
  role          String // picker | driver
  name          String
  phone         String   @unique
  vehicle_plate String?
  status        String   @default("active") // active | inactive | suspended
  created_at    DateTime @default(now())

  hub            Hub            @relation(fields: [hub_id], references: [id])
  picking_tasks  PickingTask[]
  delivery_tasks DeliveryTask[]

  @@map("partners")
}

model Category {
  id        String  @id @default(uuid())
  parent_id String?
  name      String
  slug      String  @unique
  icon      String  @default("🛒") // emoji ikon; ganti icon_url saat aset siap
  image_url String? // URL gambar kategori
  sort_order Int    @default(0)
  is_active Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id                String   @id @default(uuid())
  sku               String   @unique
  category_id       String
  name              String
  slug              String   @unique
  description       String   @default("")
  unit              String   @default("pcs") // pcs | kg | pack | liter — default unit parent
  weight_gram       Int      @default(0)
  base_price        Int // harga display (default/min varian)
  compare_at_price  Int? // harga coret display
  is_age_restricted Boolean  @default(false)
  max_qty_per_order Int      @default(10)
  status            String   @default("active") // active | inactive | archived
  /// Rekap terjual (qty) dari pesanan completed — di-update saat order selesai.
  sold_count        Int      @default(0)
  /// Rata-rata rating 1–5 dari ProductReview yang visible.
  rating_avg        Float    @default(0)
  /// Jumlah ulasan visible.
  rating_count      Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  category         Category            @relation(fields: [category_id], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  hub_stocks       HubStock[]
  cart_items       CartItem[]
  order_items      OrderItem[]
  product_reviews  ProductReview[]
  bundle_items     ProductBundleItem[]

  @@index([sold_count])
  @@index([rating_avg])
  @@map("products")
}

/// Varian jual per produk (ukuran / isi / kemasan). Stok, harga, foto efektif di level ini.
model ProductVariant {
  id               String   @id @default(uuid())
  product_id       String
  sku              String   @unique
  name             String // "500 g", "1 kg", "Isi 12"
  unit             String   @default("pcs")
  base_price       Int
  compare_at_price Int?
  weight_gram      Int      @default(0)
  is_default       Boolean  @default(false)
  is_active        Boolean  @default(true)
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  product      Product             @relation(fields: [product_id], references: [id], onDelete: Cascade)
  images       ProductImage[]
  hub_stocks   HubStock[]
  cart_items   CartItem[]
  order_items  OrderItem[]
  bundle_items ProductBundleItem[]

  @@index([product_id, is_active])
  @@map("product_variants")
}

/// Foto produk. variant_id null = foto generik produk; diisi = foto khusus varian.
model ProductImage {
  id         String  @id @default(uuid())
  product_id String
  variant_id String?
  image_url  String
  sort_order Int     @default(0)
  is_primary Boolean @default(false)

  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([product_id, is_primary])
  @@index([variant_id])
  @@map("product_images")
}

model HubStock {
  id                  String   @id @default(uuid())
  hub_id              String
  product_id          String
  variant_id          String
  price_override      Int?
  stock_qty           Int      @default(0)
  reserved_qty        Int      @default(0)
  rack_location       String   @default("")
  low_stock_threshold Int      @default(5)
  updated_at          DateTime @updatedAt

  hub             Hub             @relation(fields: [hub_id], references: [id])
  product         Product         @relation(fields: [product_id], references: [id])
  variant         ProductVariant  @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  stock_movements StockMovement[]

  @@unique([hub_id, variant_id])
  @@index([hub_id, product_id])
  @@map("hub_stocks")
}

model StockMovement {
  id             String   @id @default(uuid())
  hub_stock_id   String
  type           String // in | out | adjustment | reserve | release
  qty            Int
  reference_type String? // order | opname | po
  reference_id   String?
  note           String?
  created_by     String?
  created_at     DateTime @default(now())

  hub_stock HubStock @relation(fields: [hub_stock_id], references: [id])

  @@map("stock_movements")
}

model Cart {
  id            String   @id @default(uuid())
  user_id       String?
  session_token String?  @unique
  hub_id        String
  status        String   @default("active") // active | converted | abandoned
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user  User?      @relation(fields: [user_id], references: [id])
  hub   Hub        @relation(fields: [hub_id], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cart_id    String
  product_id String?
  variant_id String?
  bundle_id  String?
  qty        Int
  note       String?
  created_at DateTime @default(now())

  cart    Cart            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])
  bundle  ProductBundle?  @relation(fields: [bundle_id], references: [id], onDelete: Cascade)

  @@index([cart_id, variant_id])
  @@index([cart_id, product_id])
  @@index([cart_id, bundle_id])
  @@map("cart_items")
}

model Order {
  id                      String    @id @default(uuid())
  order_number            String    @unique
  user_id                 String
  hub_id                  String
  address_id              String?
  drop_point_id           String?
  batch_id                String?
  batch_name              String?
  address_snapshot        Json?
  status                  String    @default("pending_payment")
  subtotal_amount         Int
  discount_amount         Int       @default(0)
  delivery_fee            Int       @default(0)
  service_fee             Int       @default(0)
  tip_amount              Int       @default(0)
  total_amount            Int
  substitution_preference String    @default("refund") // replace | refund
  estimated_delivery_at   DateTime?
  scheduled_at            DateTime?
  delivery_note           String?   // catatan untuk penjual (dari checkout)
  cancelled_reason        String?
  created_at              DateTime  @default(now())
  completed_at            DateTime?

  user             User                 @relation(fields: [user_id], references: [id])
  hub              Hub                  @relation(fields: [hub_id], references: [id])
  address          Address?             @relation(fields: [address_id], references: [id])
  dropPoint        DropPoint?           @relation(fields: [drop_point_id], references: [id])
  batch            PurchaseBatch?       @relation(fields: [batch_id], references: [id])
  items            OrderItem[]
  status_histories OrderStatusHistory[]
  payments         Payment[]
  refunds          Refund[]
  picking_task     PickingTask?
  delivery_task    DeliveryTask?
  review           Review?
  voucher_usage    VoucherUsage?

  @@map("orders")
}

model OrderItem {
  id                     String  @id @default(uuid())
  order_id               String
  product_id             String?
  variant_id             String?
  bundle_id              String?
  product_name_snapshot  String
  variant_name_snapshot  String  @default("")
  bundle_name_snapshot   String?
  price_snapshot         Int
  qty_ordered            Int
  qty_fulfilled          Int     @default(0)
  substituted_product_id String?
  status                 String  @default("fulfilled") // fulfilled | oos | substituted | refunded
  subtotal               Int

  order            Order            @relation(fields: [order_id], references: [id])
  product          Product?         @relation(fields: [product_id], references: [id])
  variant          ProductVariant?  @relation(fields: [variant_id], references: [id])
  bundle           ProductBundle?   @relation(fields: [bundle_id], references: [id])
  freshness_claims FreshnessClaim[]

  @@index([variant_id])
  @@index([bundle_id])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  order_id   String
  from_status String
  to_status  String
  actor_type String // system | user | admin | partner
  actor_id   String?
  note       String?
  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id])

  @@map("order_status_histories")
}

model Payment {
  id                     String    @id @default(uuid())
  order_id               String
  gateway                String    @default("mock") // mock | midtrans | xendit
  method                 String    @default("ewallet") // ewallet | qris | va | card
  gateway_transaction_id String?   @unique
  amount                 Int
  status                 String    @default("pending") // pending | paid | failed | expired | refunded
  paid_at                DateTime?
  expired_at             DateTime
  raw_payload            Json?
  created_at             DateTime  @default(now())

  order   Order    @relation(fields: [order_id], references: [id])
  refunds Refund[]

  @@map("payments")
}

model Refund {
  id           String   @id @default(uuid())
  payment_id   String
  order_id     String
  amount       Int
  type         String // full | partial
  reason       String
  status       String   @default("pending") // pending | processed | failed
  processed_by String?
  created_at   DateTime @default(now())

  payment Payment @relation(fields: [payment_id], references: [id])
  order   Order   @relation(fields: [order_id], references: [id])

  @@map("refunds")
}

model Voucher {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  type             String // fixed | percentage | free_delivery
  value            Int
  max_discount     Int?
  min_order_amount Int      @default(0)
  quota_total      Int      @default(0)
  quota_per_user   Int      @default(1)
  target_segment   String   @default("all") // all | new_user | custom
  start_at         DateTime
  end_at           DateTime
  is_active        Boolean  @default(true)

  // Ketentuan voucher (opsional; kosong = tidak dibatasi)
  product_ids  String[] @default([]) // hanya berlaku utk produk tertentu
  category_ids String[] @default([]) // hanya berlaku utk kategori tertentu
  bundle_only  Boolean  @default(false) // khusus paket / bundling
  bundle_ids   String[] @default([]) // hanya berlaku utk paket tertentu
  days_of_week Int[]    @default([]) // 0=Minggu..6=Sabtu (getDay); kosong = semua hari
  start_minute Int? // menit sejak 00:00 (mis. 09:00 = 540)
  end_minute   Int? // menit sejak 00:00; end < start = lintas tengah malam

  usages            VoucherUsage[]
  claims            ClaimedVoucher[]
  referrer_rewards  Referral[]     @relation("ReferrerVoucher")
  referee_rewards   Referral[]     @relation("RefereeVoucher")

  @@map("vouchers")
}

model ClaimedVoucher {
  id         String   @id @default(uuid())
  user_id    String
  voucher_id String
  claimed_at DateTime @default(now())
  status     String   @default("claimed") // claimed | used | expired
  order_id   String?  @unique

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucher_id], references: [id], onDelete: Cascade)

  @@unique([user_id, voucher_id])
  @@map("claimed_vouchers")
}

model VoucherUsage {
  id               String   @id @default(uuid())
  voucher_id       String
  user_id          String
  order_id         String   @unique
  discount_applied Int
  used_at          DateTime @default(now())

  voucher Voucher @relation(fields: [voucher_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])
  order   Order   @relation(fields: [order_id], references: [id])

  @@map("voucher_usages")
}

model Referral {
  id                  String    @id @default(uuid())
  referrer_user_id    String
  referee_user_id     String    @unique
  status              String    @default("pending") // pending | rewarded | invalid
  referrer_voucher_id String?
  referee_voucher_id  String?
  rewarded_at         DateTime?
  created_at          DateTime  @default(now())

  referrer         User     @relation("Referrer", fields: [referrer_user_id], references: [id])
  referee          User     @relation("Referee", fields: [referee_user_id], references: [id])
  referrer_voucher Voucher? @relation("ReferrerVoucher", fields: [referrer_voucher_id], references: [id])
  referee_voucher  Voucher? @relation("RefereeVoucher", fields: [referee_voucher_id], references: [id])

  @@map("referrals")
}

/// Ulasan tingkat pesanan (kepuasan keseluruhan order).
model Review {
  id         String   @id @default(uuid())
  order_id   String   @unique
  user_id    String
  rating     Int
  comment    String?
  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  @@map("reviews")
}

/// Ulasan & rating per produk (storefront + admin).
model ProductReview {
  id           String    @id @default(uuid())
  product_id   String
  user_id      String
  order_id     String // wajib: ulasan hanya dari pesanan selesai
  rating       Int // 1–5
  comment      String?
  is_visible   Boolean   @default(true) // admin bisa sembunyikan
  admin_reply  String?
  replied_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// Satu user hanya 1 ulasan per produk per order (atau tanpa order: 1 per user+produk).
  @@unique([product_id, user_id, order_id])
  @@index([product_id, is_visible])
  @@index([created_at])
  @@map("product_reviews")
}

model FreshnessClaim {
  id              String    @id @default(uuid())
  order_item_id   String
  user_id         String
  photo_url       String
  reason          String
  status          String    @default("submitted") // submitted | approved | rejected
  resolution_type String? // refund | voucher | replacement
  handled_by      String?
  created_at      DateTime  @default(now())
  resolved_at     DateTime?

  order_item OrderItem @relation(fields: [order_item_id], references: [id])
  user       User      @relation(fields: [user_id], references: [id])

  @@map("freshness_claims")
}

model Notification {
  id       String    @id @default(uuid())
  user_id  String
  order_id String?
  channel  String    @default("push") // push | whatsapp | email
  title    String
  body     String
  status   String    @default("queued") // queued | sent | failed
  sent_at  DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model PickingTask {
  id         String    @id @default(uuid())
  order_id   String    @unique
  hub_id     String
  picker_id  String?
  status     String    @default("queued") // queued | picking | packed
  started_at DateTime?
  packed_at  DateTime?
  created_at DateTime  @default(now())

  order  Order    @relation(fields: [order_id], references: [id])
  hub    Hub      @relation(fields: [hub_id], references: [id])
  picker Partner? @relation(fields: [picker_id], references: [id])

  @@map("picking_tasks")
}

model DeliveryTask {
  id              String    @id @default(uuid())
  order_id        String    @unique
  driver_id       String?
  status          String    @default("assigned") // assigned | picked_up | on_the_way | arrived | delivered | failed
  proof_photo_url String?
  current_lat     Float?
  current_lng     Float?
  assigned_at     DateTime  @default(now())
  delivered_at    DateTime?

  order  Order    @relation(fields: [order_id], references: [id])
  driver Partner? @relation(fields: [driver_id], references: [id])

  @@map("delivery_tasks")
}

model Banner {
  id         String   @id @default(uuid())
  title      String
  image_url  String   @default("")
  target_url String   @default("/")
  placement  String   @default("home_top") // home_top | home_mid | category
  sort_order Int      @default(0)
  start_at   DateTime
  end_at     DateTime
  is_active  Boolean  @default(true)

  @@map("banners")
}

model Article {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  category     String // resep | lifestyle | news
  content      String
  cover_url    String    @default("")
  author_id    String
  status       String    @default("draft") // draft | published | archived
  published_at DateTime?

  author AdminUser @relation(fields: [author_id], references: [id])

  @@map("articles")
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  permissions Json   @default("[]")

  admin_users AdminUser[]

  @@map("roles")
}

model AdminUser {
  id            String   @id @default(uuid())
  role_id       String
  name          String
  email         String   @unique
  password_hash String
  status        String   @default("active") // active | inactive
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id])
  audit_logs AuditLog[]
  articles   Article[]

  @@map("admin_users")
}

// Live chat user ↔ admin (1 thread per user)
// status: open = sesi aktif; closed = perlu "Mulai sesi" + kategori dulu
// sender_id plain string (user_id / admin_user_id / "system") — no FK: mixed sender types
model ChatThread {
  id              String    @id @default(uuid())
  user_id         String    @unique
  status          String    @default("closed") // open | closed
  category        String    @default("") // kode kategori masalah (saat sesi dibuka)
  category_detail String    @default("") // detail singkat dari user
  admin_joined    Boolean   @default(false)
  admin_joined_at DateTime?
  admin_joined_by String    @default("")
  last_message_at DateTime  @default(now())
  last_preview    String    @default("")
  unread_admin    Int       @default(0)
  unread_user     Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user     User          @relation(fields: [user_id], references: [id])
  messages ChatMessage[]

  @@index([status, last_message_at])
  @@map("chat_threads")
}

model ChatMessage {
  id          String   @id @default(uuid())
  thread_id   String
  sender_type String // user | admin | system
  sender_id   String
  body        String   @default("")
  image_url   String? // path publik, mis. /uploads/chat/{threadId}/xxx.webp
  created_at  DateTime @default(now())

  thread ChatThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  @@index([thread_id, created_at])
  @@map("chat_messages")
}

model AuditLog {
  id            String   @id @default(uuid())
  admin_user_id String
  action        String // create | update | delete
  entity_type   String
  entity_id     String
  before_data   Json?
  after_data    Json?
  ip_address    String   @default("")
  created_at    DateTime @default(now())

  admin_user AdminUser @relation(fields: [admin_user_id], references: [id])

  @@map("audit_logs")
}

// Tabel pendukung OTP (tidak ada di ERD; kebutuhan teknis FR-1.2)
model OtpCode {
  id         String   @id @default(uuid())
  phone      String
  audience   String   @default("user") // user | partner
  code_hash  String
  attempts   Int      @default(0)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([phone, audience])
  @@map("otp_codes")
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  body       String
  type       String   @default("info") // info | promo | discount | release | warning
  target_url String?  // link opsional
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  reads      UserAnnouncementRead[]

  @@map("announcements")
}

model UserAnnouncementRead {
  user_id         String
  announcement_id String
  read_at         DateTime @default(now())

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)

  @@id([user_id, announcement_id])
  @@map("user_announcement_reads")
}

// Drop points untuk sistem pengantaran tanpa alamat lengkap
model DropPoint {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String   @default("")
  is_active Boolean  @default(true)
  sort_order Int     @default(0)
  created_at DateTime @default(now())

  orders            Order[]
  preferredByUsers  User[]  @relation("UserPreferredDropPoint")

  @@map("drop_points")
}

// ─── Order Langsung (scan QR di tempat — terpisah dari Order online) ───

model DirectProduct {
  id           String   @id @default(uuid())
  name         String
  description  String   @default("")
  category     String   @default("Order Langsung")
  price        Int
  stock_qty    Int      @default(0)
  reserved_qty Int      @default(0)
  image_url    String?
  sku          String?  @unique
  qr_token     String   @unique
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  order_items DirectOrderItem[]

  @@map("direct_products")
}

model DirectOrder {
  id              String    @id @default(uuid())
  order_number    String    @unique
  user_id         String
  status          String    @default("pending_payment") // pending_payment | completed | cancelled | expired
  subtotal_amount Int
  total_amount    Int
  paid_at         DateTime?
  expired_at      DateTime
  created_at      DateTime  @default(now())

  user    User              @relation(fields: [user_id], references: [id])
  items   DirectOrderItem[]
  payment DirectPayment?

  @@index([status, created_at])
  @@map("direct_orders")
}

model DirectOrderItem {
  id                    String @id @default(uuid())
  order_id              String
  product_id            String
  product_name_snapshot String
  price_snapshot        Int
  qty                   Int
  subtotal              Int

  order   DirectOrder   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product DirectProduct @relation(fields: [product_id], references: [id])

  @@map("direct_order_items")
}

model DirectPayment {
  id                     String    @id @default(uuid())
  order_id               String    @unique
  gateway                String    @default("pakasir")
  gateway_transaction_id String?   @unique
  amount                 Int
  status                 String    @default("pending") // pending | paid | failed | expired
  paid_at                DateTime?
  expired_at             DateTime
  raw_payload            Json?
  created_at             DateTime  @default(now())

  order DirectOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("direct_payments")
}

// ─── Sistem Batch Pembelian (Sentra New) ───

model PurchaseBatch {
  id             String    @id @default(uuid())
  name           String    @default("Batch 29")
  description    String    @default("")
  is_active      Boolean   @default(true) // Sistem batch aktif/nonaktif
  open_day       Int       @default(3)    // 0=Minggu, 1=Senin, 2=Selasa, 3=Rabu, 4=Kamis, 5=Jumat, 6=Sabtu
  open_time      String    @default("07:00") // Format "HH:mm" (WIB)
  close_day      Int       @default(4)    // 4=Kamis
  close_time     String    @default("20:00") // Format "HH:mm" (WIB)
  start_date     DateTime? // Tanggal mulai spesifik (opsional)
  end_date       DateTime? // Tanggal selesai spesifik (opsional)
  override_mode  String    @default("auto") // auto | force_open | force_closed
  closed_message String?   @default("Pembelian sentra sedang ditutup dan akan dibuka sesuai jadwal batch. Produk Order Langsung tetap bisa dipesan.")
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  orders         Order[]

  @@map("purchase_batches")
}

// ─── Produk Bundling / Paket (Sentra New) ───

model ProductBundle {
  id               String              @id @default(uuid())
  name             String
  slug             String              @unique
  description      String              @default("")
  image_url        String?
  price            Int                 // Harga jual paket
  compare_at_price Int?                // Harga coret display
  is_active        Boolean             @default(true)
  sort_order       Int                 @default(0)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  items            ProductBundleItem[]
  cart_items       CartItem[]
  order_items      OrderItem[]

  @@map("product_bundles")
}

model ProductBundleItem {
  id         String          @id @default(uuid())
  bundle_id  String
  product_id String
  variant_id String?
  qty        Int             @default(1)

  bundle     ProductBundle   @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([bundle_id])
  @@index([product_id])
  @@map("product_bundle_items")
}
